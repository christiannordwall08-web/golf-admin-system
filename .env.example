# Kopiera till .env och anpassa. .env får ALDRIG committas.

# PostgreSQL (>= 15). Lokalt utan installation: kör `npm run db:dev` i en egen terminal.
DATABASE_URL="postgresql://golf:golf@localhost:5433/golf_admin"

# Applikationens publika adress (används för origin-kontroller och länkar).
APP_URL="http://localhost:3000"

# Förste administratör, skapas av `npm run db:seed` (kräver att INGEN admin finns ännu).
# Använd ett långt, unikt lösenord (minst 12 tecken). Ta bort raderna efter första körningen.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_FIRST_NAME=""
SEED_ADMIN_LAST_NAME=""

# Externa mejlutskick är AV tills detta uttryckligen sätts till "true" (och en leverantör konfigurerats).
EMAIL_NOTIFICATIONS_ENABLED="false"
