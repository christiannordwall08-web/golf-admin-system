// =============================================================================
// PERSONAL OCH INLOGGNING
// User     = inloggning + åtkomstroll (vad får personen göra?)
// Employee = personen i personalregistret + arbetskategori (var arbetar personen?)
// Två inloggningar: Admin (kräver User.role = ADMIN) och Anställd (kräver minst en aktiv Employee).
// En person kan vara båda, och kan ha en anställning per arbetskategori. Sessionens `context`
// avgör vilken panel sessionen får använda. Se src/domain/roles.ts och docs/ARCHITECTURE.md.
// =============================================================================

model User {
  id                    String    @id @default(cuid())
  /// Alltid gemener (CHECK-constraint i databasen).
  email                 String    @unique
  /// Visningsnamn ENDAST för användare utan personalpost (t.ex. Admin). Personalens namn
  /// kommer alltid från Employee (personalregistret) – visa aldrig detta fält för dem.
  name                  String?
  passwordHash          String
  role                  UserRole
  isActive              Boolean   @default(true)
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime? @db.Timestamptz(3)
  lastLoginAt           DateTime? @db.Timestamptz(3)
  /// Får notis (och ser bilden direkt) när personalen skickar in ett dagsavslut. Gäller administratörer.
  receivesDailyClosings Boolean   @default(false)
  /// Testdata är alltid markerad och skapas bara av prisma/seed-demo.ts i utvecklingsmiljö.
  isTestData            Boolean   @default(false)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  /// En person kan ha flera anställningar (en per arbetskategori), t.ex. både Golfshop och Bollplockare.
  employees     Employee[]
  sessions      Session[]
  notifications Notification[]

  // Inversa sidor för "utfört av"-kolumner (historik ska alltid kunna kopplas till en användare)
  auditLogs               AuditLog[]
  shiftsCreated           Shift[]                  @relation("ShiftCreatedBy")
  assignmentChanges       ShiftAssignmentHistory[] @relation("AssignmentChangedBy")
  schedulePublications    SchedulePublication[]
  swapDecisions           ShiftSwapRequest[]       @relation("SwapDecidedBy")
  swapMessages            ShiftSwapMessage[]
  workTimeApprovals       WorkTimeEntry[]          @relation("WorkTimeApprovedBy")
  workTimeCorrections     WorkTimeCorrection[]
  payRatesCreated         PayRate[]
  payrollApprovals        MonthlyPayrollReport[]   @relation("PayrollApprovedBy")
  payrollLocks            MonthlyPayrollReport[]   @relation("PayrollLockedBy")
  payrollAdjustments      PayrollAdjustment[]
  dailyClosingReviews     DailyClosing[]           @relation("DailyClosingReviewedBy")
  dailyClosingAssignments DailyClosingAssignment[]

  // Bollplockare (prisma/schema/bollplockare.prisma)
  bollplockareSettingsUpdates BollplockareSettings[]    @relation("BollplockareSettingsUpdatedBy")
  bollplockareOverrides       BollplockareDayOverride[] @relation("BollplockareOverrideCreatedBy")
  gpsWorkAreaUpdates          GpsWorkArea[]             @relation("GpsWorkAreaUpdatedBy")
  gpsPausesVoided             GpsPause[]                @relation("GpsPauseVoidedBy")
  gpsEvents                   GpsEvent[]                @relation("GpsEventActor")
}

model Session {
  /// SHA-256 (hex) av sessionstoken. Själva token finns bara i användarens cookie.
  id         String         @id
  userId     String
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  /// Absolut maxlängd.
  expiresAt  DateTime       @db.Timestamptz(3)
  /// För inaktivitetstidsgräns.
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?
  /// Vilken inloggning som användes. ADMIN = adminpanelen, EMPLOYEE = anställdpanelen. Styr vad sessionen får göra.
  context    SessionContext @default(EMPLOYEE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Employee {
  id                     String           @id @default(cuid())
  /// Null = personen har ännu ingen inloggning (t.ex. bollplockare som onboardas senare).
  /// En användare kan ha en anställning per kategori (unik på userId + category).
  userId                 String?
  firstName              String
  lastName               String
  category               WorkCategory
  status                 EmploymentStatus @default(ACTIVE)
  /// Kontaktuppgift – inte inloggning (inloggning är User.email).
  email                  String?
  phone                  String?
  employmentStartDate    DateTime?        @db.Date
  employmentEndDate      DateTime?        @db.Date
  /// Om true får den anställda se sin egen preliminära ersättning (aldrig andras).
  showEarningsToEmployee Boolean          @default(false)
  /// false = ingår INTE i timlön och löneunderlag (t.ex. en administratör som styr över de anställda).
  /// Visas då som "Ej timlön" i stället för "Lön saknas" och räknas inte i timlönekostnaden.
  hourlyPaid             Boolean          @default(true)
  /// true = har fast månadslön i stället för timlön (kräver hourlyPaid = false, se CHECK i databasen).
  /// Visas som "Fast lön" och ingår inte i timlönekostnaden.
  fixedSalary            Boolean          @default(false)
  isTestData             Boolean          @default(false)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  payRates                 PayRate[]
  shiftsAssigned           Shift[]                  @relation("ShiftAssignee")
  shiftsOriginallyOwned    Shift[]                  @relation("ShiftOriginalAssignee")
  assignmentsFrom          ShiftAssignmentHistory[] @relation("AssignmentFrom")
  assignmentsTo            ShiftAssignmentHistory[] @relation("AssignmentTo")
  shiftApprovals           ShiftApproval[]
  swapRequestsMade         ShiftSwapRequest[]       @relation("SwapRequester")
  swapRequestsReceived     ShiftSwapRequest[]       @relation("SwapProposedColleague")
  workTimeEntries          WorkTimeEntry[]
  payrollReportLines       PayrollReportLine[]
  payrollAdjustments       PayrollAdjustment[]
  dailyClosings            DailyClosing[]
  dailyClosingsResponsible DailyClosingAssignment[]

  @@unique([userId, category])
  @@index([category, status])
  @@index([lastName, firstName])
}
